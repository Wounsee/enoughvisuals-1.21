{
  "schemaVersion": 1,
  "id": "cosmetic",
  "version": "${version}",

  "name": "Enough Cosmetic",
  "description": "Embedded Lua cosmetic rendering runtime",
  "authors": ["wounsee"],

  "license": "Polyform-Noncommercial-1.0.0",
  "icon": "assets/cosmetic/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "fun.wounsee.cosmetic.fabric.CosmeticModFabric"
    ]
  },
  "mixins": [
    "cosmetic.mixins.json",
    "cosmetic-common.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft":  "<=${minecraft_version} >1.21.1",
    "fabricloader": ">=0.15"
  },
  "conflicts": {}
}
