{
  "schemaVersion": 1,
  "id": "enoughvisuals",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [],
  "contact": {
    "homepage": "https://enoughvisuals.fun/tg"
  },
  "license": "All rights reserved",
  "icon": "assets/enough/logo/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fun.enoughvisuals.Enough"
    ]
  },
  "jars": [
    {
      "file": "META-INF/jars/hold-my-items.jar"
    },
    {
      "file": "META-INF/jars/cloth-config.jar"
    },
    {
      "file": "META-INF/jars/modmenu.jar"
    },
    {
      "file": "META-INF/jars/placeholder-api.jar"
    }
  ],
  "mixins": [
    "enoughvisuals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
