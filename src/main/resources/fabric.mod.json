{
  "schemaVersion": 1,
  "id": "enoughvisuals",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [],
  "contact": {
    "homepage": "https://enoughvisuals.fun/tg"
  },
  "license": "All rights reserved",
  "icon": "assets/enough/logo/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fun.enoughvisuals.Enough",
      "punchy.fabric.PunchyFabricClient"
    ]
  },
  "mixins": [
    "enoughvisuals.mixins.json",
    "punchy.mixins.json",
    "punchy.compat.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/cosmetic.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
